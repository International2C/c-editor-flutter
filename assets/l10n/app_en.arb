  "moduleTitle_PVZ1CopycatsModuleProperties": "Guess Who I Am",
  "moduleDesc_PVZ1CopycatsModuleProperties": "Configures Magic Hat summons, enables Magic Hat selection",
  "pvz1CopycatsModuleTitle": "Guess Who I Am",
  "pvz1CopycatsSectionParams": "Parameters",
  "pvz1CopycatsFieldZombieWeightLabel": "Zombie weight (ZombieWeight)",
  "pvz1CopycatsHelpZombieWeight": "The probability of summoning a zombie per attempt (0–1). The probability of summoning a plant is 1 minus this value.",
  "pvz1CopycatsFieldSpawnPlantLevelLabel": "Plant level (SpawnPlantLevel)",
  "pvz1CopycatsHelpSpawnPlantLevel": "The level of plants summoned by the Magic Hat.",
  "pvz1CopycatsSectionPlantBlackList": "Plant blacklist (PlantBlackList)",
  "pvz1CopycatsHelpPlantBlackList": "Each type of Magic Hat has its own plant pool. This pool is not affected by the blacklist, so modifying the blacklist has no effect.",
  "pvz1CopycatsSectionZombieWhiteList": "Zombie whitelist (ZombieWhiteList)",
  "pvz1CopycatsHelpZombieWhiteList": "Only zombies in the whitelist can be summoned by the Magic Hat.",
  "pvz1CopycatsHelpTip": "After adding this module, remember to pre-select Magic Hats in the Seed Bank or Conveyor Belt module. Long press or right-click the Magic Hat in the plant selection screen to preview the plants it can summon.",
  "pvz1CopycatsHelpOverview": "This module configures the summon behavior of Magic Hats that can be planted in the seed slots, commonly used in the Memory Lane mini-game \"Guess Who I Am\". Without this module, Magic Hats will not function properly. Different types of Magic Hat vary in sun cost and cooldown time. After being planted, a Magic Hat will transform into a random plant or zombie. Plants are selected from the Magic Hat’s own plant pool, while zombies are selected only from the whitelist. The weights of individual entries in the plant or zombie pools cannot be adjusted.",
  "pvz1CopycatsHelpFieldsTitle": "Parameter details",
  "pvz1CopycatsPlantListEmpty": "Blacklist is empty",
  "pvz1CopycatsZombieListEmpty": "Whitelist is empty",
  "pvz1CopycatsAddPlant": "Add plant to blacklist",
  "pvz1CopycatsAddZombie": "Add zombie to whitelist",
  "moduleTitle_PVZ1SeeingStarsModuleProperties": "Seeing Stars",
  "moduleDesc_PVZ1SeeingStarsModuleProperties": "Configures target plants and wave loop for the Seeing Stars minigame",
  "pvz1SeeingStarsModuleTitle": "Seeing Stars",
  "pvz1SeeingStarsSectionParams": "Parameters",
  "pvz1SeeingStarsSectionMatchPlants": "Target plants (MatchPlants)",
  "pvz1SeeingStarsHelpMatchPlants": "Select a cell on the grid and add a plant. If the cell already has a plant, the new one replaces it. These plants appear as transparent guides in the level. The level is won when every target cell contains the matching plant. Target cells only allow the matching target plant and vine plants; other plants cannot be planted there.",
  "pvz1SeeingStarsFieldCycleIndexLabel": "Cycle wave (CycleIndex)",
  "pvz1SeeingStarsHelpCycleIndex": "The zero-based index of the first wave to repeat after the final wave. For example, in a 15-wave level with a value of 5, wave 15 is followed by wave 6. Waves keep looping until the pattern is complete.",
  "pvz1SeeingStarsFieldSettlementDurationLabel": "Settlement delay (SettlementDuration)",
  "pvz1SeeingStarsHelpSettlementDuration": "After the pattern is complete, the specified delay begins. When it ends, the level is won even if the target cells no longer contain the matching plants. The delay only applies when neither Loot Drop nor Bronze Matrix Loot Drop is present.",
  "pvz1SeeingStarsHelpOverview": "Configures the Memory Lane minigame Seeing Stars. The name comes from the original game's level, where players had to plant Starfruit in a star-shaped pattern. Follow the guides on the lawn and plant the matching plants in the indicated cells to win. Meanwhile, the configured zombie waves repeat, disrupting the player's planting.",
  "pvz1SeeingStarsHelpFieldsTitle": "Parameter details",
  "pvz1SeeingStarsHelpWinCon": "Do not combine this module with Loot Drop, Bronze Matrix Loot Drop, Level Timer, Bemarbled, or other modules with their own end conditions. They may override or interfere with Seeing Stars' win condition and disrupt the minigame.\nSeeing Stars is also incompatible with Wave Generator and will crash the level if both are used. Use with caution.",
  "pvz1SeeingStarsMatchPlantsEmpty": "No pattern configured yet. Select any cell on the grid and add a plant.",
  "seeingStarsWinConWarningTitle": "Conflicting win conditions",
  "seeingStarsWinConWarning": "Seeing Stars ends the level when the pattern is complete. Do not combine it with Loot Drop, Bronze Matrix Loot Drop, Level Timer, Bemarbled, or other modules with their own end conditions, as they may override or interfere with its win condition.",
  "seeingStarsCycleWaveLabel": "Cycle wave (CycleIndex, 0-based)",
  "seeingStarsSettlementLabel": "Settlement delay (SettlementDuration, seconds)",
  "pvz1SeeingStarsHelpTipsTitle": "Friendly Reminder",
  "seeingStarsCompatibilityWarningTitle": "Module compatibility warning",
  "seeingStarsCompatibilityWarning": "Seeing Stars is incompatible with Wave Generator and will cause the level to crash. Use with caution.",
  "seeingStarsCycleWaveBadge": "Wave loop",
  "seeingStarsCycleWaveInfo": "After the final wave, zombies start spawning again from wave {wave}. Waves repeat until every target cell contains the matching plant.",
  "@seeingStarsCycleWaveInfo": {"placeholders":{"wave":{"type":"int"}}},
  "seeingStarsMatchPlants": "Target plants",
