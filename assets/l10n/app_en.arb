  "gravityRetractDuration": "Device retraction cooldown (RetractDuration, seconds)",
  "gravityPlantExitDelay": "Time until a floating plant disappears (PlantExitDelay, seconds)",
  "gravityZombieRiseDuration": "Zombie ascent time (ZombieRiseDuration, seconds)",
  "gravityZombieTranslateDuration": "Airborne zombie travel time (ZombieTranslateDuration, seconds)",
  "gravityZombieFallDuration": "Zombie landing time at its destination (ZombieFallDuration, seconds)",
