      }
    }
  },
  "pvz1PassageFieldGridXMax": "Maximum spawn column (GridXMax)",
  "pvz1PassageHelpGridXMax": "The rightmost column where portals may spawn. The left boundary of this lawn is column 0, and the right boundary is column {maxIndex}. This value must be greater than the minimum column value.",
  "@pvz1PassageHelpGridXMax": {
